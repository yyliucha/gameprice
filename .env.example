# 复制成 .env 后修改：cp .env.example .env
#
# 【方式一】使用自带的 PostgreSQL 容器（默认）
COMPOSE_PROFILES=bundled
POSTGRES_PASSWORD=改成你自己的强密码

# 【方式二】使用你现有的外部 PostgreSQL
#   1) 把上面 COMPOSE_PROFILES 整行删掉或留空（COMPOSE_PROFILES=）
#   2) 取消下面这行注释并填好你的地址
# DATABASE_URL=postgres://user:password@10.0.0.5:5432/gameprice

# ---- 采集相关 ----
# ITAD 官方 API key（https://isthereanydeal.com/apps/my/），不填则跳过 itad 源
ITAD_API_KEY=

# 各源开关与间隔（分钟）
STEAM_ENABLED=1
SONKWO_ENABLED=1
ITAD_ENABLED=1
STEAM_INTERVAL_MIN=60
SONKWO_INTERVAL_MIN=60
ITAD_INTERVAL_MIN=1440

# ---- 其它 ----
TZ=Asia/Shanghai
LOG_LEVEL=info
# 首次启动是否自动导入 data/games.json
SEED_ON_START=1
# 启动时最多等数据库多少秒
DB_WAIT_SEC=60
