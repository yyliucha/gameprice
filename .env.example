# 全部可选项。什么都不配也能跑：docker compose up -d --build 即可。
# 需要自定义时：cp .env.example .env 再改。
#
# 【方式一】使用自带的 PostgreSQL 容器（默认）
# db 与 app 默认都会启动，不需要任何变量。
# 密码默认不需要（compose 内网 trust 认证，端口不对外暴露）。
# 若想启用密码：设 POSTGRES_PASSWORD，并把 POSTGRES_HOST_AUTH_METHOD 改成 scram-sha-256，
# 同时显式设置 DATABASE_URL=postgres://user:密码@db:5432/gameprice
# POSTGRES_PASSWORD=
# POSTGRES_HOST_AUTH_METHOD=trust

# 【方式二】使用你现有的外部 PostgreSQL
#   填好下面这行，然后 `docker compose up -d app`（只起 app，不起 db）
# DATABASE_URL=postgres://user:password@10.0.0.5:5432/gameprice

# 兼容项：旧版本靠它选择是否启动 db，现在不再需要（留空即可）
# COMPOSE_PROFILES=

# ---- 采集相关 ----
# ITAD 官方 API key（https://isthereanydeal.com/apps/my/），不填则跳过 itad 源
ITAD_API_KEY=

# 各源开关与间隔（分钟）
STEAM_ENABLED=1
SONKWO_ENABLED=1
ITAD_ENABLED=1
STEAM_INTERVAL_MIN=60
SONKWO_INTERVAL_MIN=60
ITAD_INTERVAL_MIN=1440
# GOG 用官方 catalog 接口，Humble 按 slug 探测商品页（命中率取决于 slug 命名）
GOG_ENABLED=1
HUMBLE_ENABLED=1
GOG_INTERVAL_MIN=720
# 多区服采集（逗号分隔，可选 cn,hk,tw,us,jp,ru,tr,ar）
GOG_REGIONS=cn
HUMBLE_INTERVAL_MIN=720
# 杉果 SKU 增量发现（按 id 从前沿向后探测，连续空壳即停）
DISCOVER_ENABLED=1
DISCOVER_INTERVAL_MIN=720

# ---- 静态价格页 ----
# 采集成功后自动重建 out/（置 0 关闭，例如由 CI 构建页面）
CHART_ON_SYNC=1
# 输出目录（容器内默认 /app/out）
OUT_DIR=out

# ---- 出网代理（国内服务器访问 Steam 时需要，详见 docs/DEPLOY.md）----
# 只作用于 Steam 域名（store/api/community），其余源仍直连
# STEAM_PROXY=http://127.0.0.1:7890
# 通用代理（作用于所有未被 NO_PROXY 排除的主机）
# HTTPS_PROXY=http://10.0.0.5:3128
# 排除列表，逗号分隔
# NO_PROXY=sonkwo.hk,sonkwo.cn
# 只支持 http/https 代理（不支持 socks5）

# ---- 降价提醒 ----
ALERTS_ENABLED=1
ALERTS_INTERVAL_MIN=360

# 通道一：通用 webhook（POST 一个 JSON，含 text 与 alerts 数组）
ALERT_WEBHOOK_URL=

# 通道二：企业微信群机器人（群设置 → 添加机器人 → 复制 webhook 地址）
WECOM_WEBHOOK_URL=

# 通道三：邮件（自己实现的 SMTP，支持 STARTTLS 与 AUTH PLAIN/LOGIN）
# 465 端口一般用隐式 TLS（SMTP_SECURE=1）；587 端口用 STARTTLS（SMTP_SECURE=0）
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 多个收件人用逗号分隔
ALERT_EMAIL_TO=

# ---- 采集熔断 ----
# 同一任务连续失败 N 次后暂停 COOLDOWN 分钟，避免持续撞墙被风控
CIRCUIT_THRESHOLD=3
CIRCUIT_COOLDOWN_MIN=360

# ---- 其它 ----
TZ=Asia/Shanghai
LOG_LEVEL=info
# 首次启动是否自动导入 data/games.json
SEED_ON_START=1
# 启动时最多等数据库多少秒
DB_WAIT_SEC=60
