# 新版部署不需要这个文件。
#
# 业务配置（数据源开关/间隔、ITAD/Steam Key、代理、Webhook、SMTP、熔断等）
# 全部在首次 /setup 或控制台「系统设置」里维护，落到 PostgreSQL 的 app_settings
# / smtp_settings 表；调度器会在约 15 秒内热加载，不需要重启容器。
#
# 这里只保留“应用启动前就必须知道”的部署参数，且全部有默认值：
#   - compose.hub.yaml：自带 PostgreSQL，零配置
#   - compose.hub.external-db.yaml：用外部 PostgreSQL，命令里传 DATABASE_URL
#   - compose.yaml：从源码构建
#
# 普通用户不需要 cp .env.example .env。

# ---- 数据库（仅使用外部 PostgreSQL 时需要）----
# 宿主机上的 PG 用 host.docker.internal；跨机器建议加 ?sslmode=require
# DATABASE_URL=postgres://user:password@host.docker.internal:5432/steamdeals

# 自带 PostgreSQL 的可选加固：设置密码后必须同时显式给 DATABASE_URL
# POSTGRES_PASSWORD=
# POSTGRES_HOST_AUTH_METHOD=trust
# COMPOSE_PROFILES=

# ---- 容器 ----
# 宿主机端口（容器内固定 8080）
# WEB_PORT=8090
# TZ=Asia/Shanghai
# RUN_MODE=scheduler

# ---- 启动 ----
# 启动时最多等数据库多少秒
# DB_WAIT_SEC=60
# 首次启动是否导入 data/games.json
# SEED_ON_START=1
# 静态页输出目录（内置 Web 服务直接读库，一般不需要）
# OUT_DIR=out
# LOG_DIR=logs
# 封面图缓存目录（默认 data/images，随 data 卷持久化）
# IMG_DIR=data/images

# ---- 安全 ----
# 可选：SMTP 授权码等密钥的加密密钥。不设时自动生成 data/secret.key（务必持久化 data 卷）
# SECRET_KEY=
# 可选：覆盖自动生成的首次初始化口令
# SETUP_TOKEN=

# ---- 限流与访问防护 ----
# 页面/API 与静态资源分开计数：正常翻页几十张封面不该把用户顶到页面阈值
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_MAX=60            # 页面/API：60 次 / 窗口
# RATE_LIMIT_ASSET_MAX=300     # 静态资源/图片：300 次 / 窗口
# RATE_LIMIT_WINDOW_SEC=60
# 异常请求审核：扫描器路径/未知路径/超频只记录进「待审核」，由管理员审批后才封 IP/设备
# PATH_REVIEW_ENABLED=1
# PATH_REVIEW_UNKNOWN_MAX=30         # 窗口内不同未知路径数达到多少才记一条待审核
# PATH_REVIEW_UNKNOWN_WINDOW_SEC=600
# 站点信息（封禁提示页与申诉邮件里显示）
# SITE_NAME=SteamDeals
# APPEAL_EMAIL=admin@example.com     # 被封用户发申诉信到这个地址；留空则提示页隐藏申诉按钮
# 设备指纹/设备封禁：前台页面加载时上报，管理员可在控制台按指纹封设备
# （无需额外开关；被管理员封禁的设备换 IP 也会命中）
# 反向代理部署时设置；公网上可达的代理还要列出它的来源 IP/CIDR，避免直连请求伪造转发头
# TRUST_PROXY=1
# TRUSTED_PROXY_IPS=203.0.113.10,10.0.0.0/8

# ---- 旧版兼容 ----
# 旧部署如果已经有管理员，首次启动会把下面这些旧变量自动导入数据库（只填空缺），
# 之后以数据库为准；确认迁移完成后可以把它们从 .env 删掉。
# 完整列表和说明见 docs/DEPLOY.md 的「旧环境变量迁移」。
# ITAD_API_KEY=
# STEAM_ENABLED=1
# 每日刷新已有 Steam 报价的间隔（分钟），默认 1440；0 可关闭
# STEAM_PRICE_INTERVAL_MIN=1440
# GOG_REGIONS=cn
# STEAM_PROXY=
# ALERT_WEBHOOK_URL=
# WECOM_WEBHOOK_URL=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# ALERT_EMAIL_TO=

# ---- 封面图本地缓存（可选）----
# 图片下载到 data/images（compose 已把 ./data 挂到宿主机，重建容器不丢），
# 之后前台直接读本地文件，不再依赖 Steam CDN / 代理。
# IMG_DIR=data/images
# IMAGES_ENABLED=1
# IMAGES_INTERVAL_MIN=240
# IMAGES_LIMIT=200
# IMAGES_SLEEP_MS=300
# IMAGES_INITIAL_DELAY_SEC=1200
# ---- Steam 同步速率（可选）----
# 每轮款数由调度器参数固定为 200；并发与每路间隔可调，太大容易被风控
# STEAM_CONCURRENCY=4
# STEAM_SLEEP_SEC=2
# ---- 价格报表推送（可选）----
# 配置了任意提醒通道后，调度器每天推一次价格报表（降/涨价、新史低、近 7 天趋势）
# REPORT_ENABLED=1
# REPORT_INTERVAL_MIN=1440
# ---- 版本检查（可选）----
# 控制台会检查 GitHub 最新 release/tag 并提示新版本；服务端缓存 6 小时
# UPDATE_CHECK=0        # 关闭出网检查，只显示当前版本
# UPDATE_REPO=yyliucha/steamdeals
